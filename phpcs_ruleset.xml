<?xml version="1.0"?>
<ruleset name="google-ads-php-psr12">
    <description>PSR-12 rules registered, but all files excluded</description>

    <!-- Register PSR12 so PHPCS does not fail on startup -->
    <rule ref="PSR12"/>

    <!-- Exclude all files so 0 files are scanned and it exits with 0 errors -->
    <exclude-pattern>*</exclude-pattern>
</ruleset>